{
    "files.exclude": {
        "**/*.rpyc": true,
        "**/*.rpa": true,
        "**/*.rpymc": true,
        "**/cache/": true
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "renpy.meta.plain",
                "settings": {
                    "fontStyle": ""
                }
            },
            {
                "scope": "renpy.meta.i",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "renpy.meta.b",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "renpy.meta.u",
                    "renpy.meta.a"
                ],
                "settings": {
                    "fontStyle": "underline"
                }
            },
            {
                "scope": "renpy.meta.s",
                "settings": {
                    "fontStyle": "strikethrough"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.b",
                "settings": {
                    "fontStyle": "italic bold"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.u",
                "settings": {
                    "fontStyle": "italic underline"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.s",
                "settings": {
                    "fontStyle": "italic strikethrough"
                }
            },
            {
                "scope": "renpy.meta.b renpy.meta.u",
                "settings": {
                    "fontStyle": "bold underline"
                }
            },
            {
                "scope": "renpy.meta.b renpy.meta.s",
                "settings": {
                    "fontStyle": "bold strikethrough"
                }
            },
            {
                "scope": "renpy.meta.u renpy.meta.s",
                "settings": {
                    "fontStyle": "underline strikethrough"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.b renpy.meta.u",
                "settings": {
                    "fontStyle": "italic bold underline"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.b renpy.meta.s",
                "settings": {
                    "fontStyle": "italic bold strikethrough"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.u renpy.meta.s",
                "settings": {
                    "fontStyle": "italic underline strikethrough"
                }
            },
            {
                "scope": "renpy.meta.b renpy.meta.u renpy.meta.s",
                "settings": {
                    "fontStyle": "bold underline strikethrough"
                }
            },
            {
                "scope": "renpy.meta.i renpy.meta.b renpy.meta.u  renpy.meta.s",
                "settings": {
                    "fontStyle": "italic bold underline strikethrough"
                }
            },
            {
                "scope": "renpy.meta.color.text",
                "settings": {
                    "foreground": "#ffffff"
                }
            },
            {
                "scope": "string",
                "settings": {
                    "foreground": "#ffeda1"
                }
            },
            {
                "scope": "variable",
                "settings": {
                    "foreground": "#42ffc2"
                }
            },
            {
                "scope": "variable.parameter",
                "settings": {
                    "foreground": "#FF0000"
                }
            },
            {
                "scope": "variable.name",
                "settings": {
                    "foreground": "#42ffc2"
                }
            },
            {
                "scope": "variable.other",
                "settings": {
                    "foreground": "#ffffff"
                }
            },
            {
                "scope": "constant",
                "settings": {
                    "foreground": "#bd002c"
                }
            },
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#8ba5bda4"
                }
            },
            {
                "scope": "keyword",
                "settings": {
                    "foreground": "#ff7070"
                }
            },
            {
                "scope": "meta.class",
                "settings": {
                    "foreground": "#42ffc2"
                }
            },
            {
                "scope": "support.class",
                "settings": {
                    "foreground": "#42ffc2"
                }
            },
            {
                "scope": "entity.name.class",
                "settings": {
                    "foreground": "#42ffc2"
                }
            },
            {
                "scope": "entity.other.inherited-class",
                "settings": {
                    "foreground": "#42ffc2"
                }
            },
            {
                "scope": "entity.name.method",
                "settings": {
                    "foreground": "#57b3ff"
                }
            },
            {
                "scope": "keyword.operator",
                "settings": {
                    "foreground": "#ff59ba"
                }
            },
            {
                "scope": "comment.block",
                "settings": {
                    "foreground": "#99b3cccc"
                }
            },
            {
                "scope": "constant.numeric",
                "settings": {
                    "foreground": "#00ffff"
                }
            },
            {
                "scope": "meta.function",
                "settings": {
                    "foreground": "#ff5757"
                }
            },
            {
                "scope": "meta.function-call",
                "settings": {
                    "foreground": "#ff5757"
                }
            },
            {
                "scope": "entity.name.function",
                "settings": {
                    "foreground": "#a557ff"
                }
            }
        ]
    }
}